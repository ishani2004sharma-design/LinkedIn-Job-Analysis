{
  "name": "LinkedIn Dark",
  "dataColors": ["#38BDF8", "#2F7DE1", "#2DD4BF", "#F5B73B", "#A78BFA", "#4A5B7C", "#F472B6", "#34D399"],
  "background": "#13213A",
  "foreground": "#E8EEF9",
  "tableAccent": "#38BDF8",
  "good": "#2DD4BF",
  "neutral": "#F5B73B",
  "bad": "#F472B6",
  "textClasses": {
    "label":    { "color": "#E8EEF9", "fontFace": "Segoe UI" },
    "title":    { "color": "#E8EEF9", "fontFace": "Segoe UI Semibold", "fontSize": 12 },
    "callout":  { "color": "#38BDF8", "fontFace": "Segoe UI Semibold", "fontSize": 28 },
    "header":   { "color": "#E8EEF9", "fontFace": "Segoe UI Semibold", "fontSize": 12 }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [ { "color": { "solid": { "color": "#0B1426" } }, "transparency": 0 } ]
      }
    },
    "*": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#13213A" } }, "transparency": 0 } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#22365A" } }, "radius": 8 } ],
        "title": [ { "show": true, "fontColor": { "solid": { "color": "#E8EEF9" } }, "fontSize": 12 } ]
      }
    }
  }
}
